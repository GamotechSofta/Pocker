# Copy to an untracked file and point Compose at it with --env-file.
MONGO_ROOT_USERNAME=poker_database_owner
MONGO_APP_USERNAME=poker_runtime
MONGODB_DB=poker_staging
MONGODB_URI=mongodb://poker_runtime:REPLACE_WITH_URI_ENCODED_APP_PASSWORD@mongo:27017/poker_staging?replicaSet=poker-staging&authSource=poker_staging&maxPoolSize=40&serverSelectionTimeoutMS=5000
MONGO_ROOT_PASSWORD_FILE=.secrets/mongo-root-password
MONGO_APP_PASSWORD_FILE=.secrets/mongo-app-password
MONGO_KEYFILE_FILE=.secrets/mongo-keyfile
MONGODB_AUTO_INDEX_CREATION=false
JWT_SECRET=REPLACE_WITH_RANDOM_PLAYER_SIGNING_KEY
ADMIN_JWT_SECRET=REPLACE_WITH_DISTINCT_RANDOM_ADMIN_SIGNING_KEY
ADMIN_API_KEY=REPLACE_WITH_DISTINCT_RANDOM_OPERATIONS_KEY
TOURNAMENT_CLOCK_ADMIN_KEY=REPLACE_WITH_DISTINCT_RANDOM_CLOCK_KEY
ADMIN_BOOTSTRAP_USERNAME=REPLACE_WITH_INITIAL_ADMIN
ADMIN_BOOTSTRAP_PASSWORD=REPLACE_WITH_INITIAL_ADMIN_PASSWORD
PLAYER_ORIGIN=http://127.0.0.1:15775
ADMIN_ORIGIN=http://127.0.0.1:15680
PLAYER_PROXY_PORT=15775
ADMIN_PROXY_PORT=15680
