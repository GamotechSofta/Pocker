# Database (MongoDB)
MONGODB_URI=mongodb://localhost:27017/poker
MONGODB_DB=poker
MONGODB_PORT=27017

# Backend
SERVER_PORT=8080
JWT_SECRET=replace-with-a-long-random-secret-at-least-32
JWT_EXPIRATION_MS=86400000
# Docker compose defaults to prod (no seeded players). Local `mvnw spring-boot:run` uses profile `dev`.
SPRING_PROFILES_ACTIVE=prod

# Default table (engine). Lobby APIs will read these in a later phase.
SMALL_BLIND=10
BIG_BLIND=20
STARTING_CHIPS=1000
MAX_PLAYERS=6
MAX_DRAW_COUNT=5

# Frontend
VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080
